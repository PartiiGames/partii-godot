; Copied into addons/partii/ together with the built libraries in addons/partii/bin/ (tests/native and
; the release package do this). Not in addons/ by default: without the libraries Godot reports errors.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = false

[libraries]
linux.x86_64 = "res://addons/partii/bin/libpartii_godot.linux.x86_64.so"
windows.x86_64 = "res://addons/partii/bin/partii_godot.windows.x86_64.dll"
macos = "res://addons/partii/bin/libpartii_godot.macos.framework"
