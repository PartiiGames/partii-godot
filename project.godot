; Partii for Godot: the demo project. The addon is addons/partii; the demo is demo/demo.tscn.

config_version=5

[application]

config/name="Partii for Godot demo"
config/version="0.3.0"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Partii="*res://addons/partii/partii.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/partii/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
