# Godot's Asset Library downloads this repo's zip: keep only the add-on in it.
# Everything except addons/ is export-ignore, so GitHub's zip (git archive) leaves it out.
/**              export-ignore
/addons          -export-ignore
/addons/**       -export-ignore
# The browser half's build sources: games use the built partii-sdk.js / partii-engine.*.
/addons/partii/web/** export-ignore
/addons/partii/web   export-ignore
# Line endings stay as written.
* text=auto eol=lf
*.png binary
